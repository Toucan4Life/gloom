{ 
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Profiling", // Should launch http://127.0.0.1:8080/snakeviz/%2Fworkspaces%2Fgloom%2Fprof%2Fcombined.prof
            "preLaunchTask": "run_profiling_test", // The name of the task defined above
            "request": "launch",
            "type": "debugpy",
            "module": "snakeviz",
            "args": ["prof/combined.prof"] 
        },
        {
            "name": "Python: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "server/app.py",
                "FLASK_DEBUG": "True"
            },
            "args": [
                "run",
                "--no-debugger"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ]
}