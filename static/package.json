{
  "name": "gloom",
  "version": "3.0.0",
  "description": "A Gloomhaven monster mover web app and server.",
  "main": "index.js",
  "scripts": {
    "copy-python": "node scripts/copy-python.js",
    "build": "npm run copy-python && webpack --progress --mode production --config webpack.config.js",
    "dev-build": "npm run copy-python && webpack --progress --mode development --config webpack.config.js",
    "watch": "npm run copy-python && webpack watch --progress --mode development --config webpack.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toucan4Life/gloom.git"
  },
  "author": "Toucan4Life",
  "contributors": [
    "Daniel Nelson (original author, https://github.com/AluminumAngel/gloom)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Toucan4Life/gloom/issues"
  },
  "homepage": "https://github.com/Toucan4Life/gloom#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "react": "^16.6.0",
    "react-dom": "^16.6.0",
    "reactstrap": "^8.0.0",
    "webpack": "^5.67.0",
    "webpack-cli": "^4.9.2"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ],
    "plugins": [
      "@babel/plugin-transform-class-properties"
    ]
  },
  "dependencies": {
    "npm": "^6.14.15"
  }
}
